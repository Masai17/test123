name: Padel Auto-Reservering

on:
  workflow_dispatch:
    inputs:
      speel_datum_tijd:
        description: "Speeldag + tijd (DD-MM-YYYY HH:MM)"
        required: true
      partners:
        description: "Partners (kommagescheiden)"
        required: false
        default: ''

jobs:
  reserveer:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Python installeren
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Packages installeren
        run: |
          pip install playwright
          playwright install chromium
          playwright install-deps chromium

      - name: Laad reservering uit bestand
        run: |
          if [ -f reservering.env ]; then
            cat reservering.env >> $GITHUB_ENV
          fi

      - name: Padel reservering uitvoeren
        env:
          KNLTB_GEBRUIKERSNUMMER: ${{ secrets.KNLTB_GEBRUIKERSNUMMER }}
          KNLTB_WACHTWOORD: ${{ secrets.KNLTB_WACHTWOORD }}
          KNLTB_WEBSITE: ${{ secrets.KNLTB_WEBSITE }}
          INTRODUCEE_EMAIL: ${{ secrets.INTRODUCEE_EMAIL }}
          SPEEL_DATUM_TIJD: ${{ github.event.inputs.speel_datum_tijd || env.SPEEL_DATUM_TIJD }}
          PARTNERS: ${{ github.event.inputs.partners || env.PARTNERS }}
          PYTHONUNBUFFERED: "1"
        run: python padel_reserveer.py
